# DownloadPulse Desktop Agent Configuration

# Path to Downloads folder (If omitted, automatically defaults to OS user's Downloads directory)
# DOWNLOADS_DIR=C:\Users\Username\Downloads

# File stability check parameters
# How often (in milliseconds) to check if a changing file's size has stabilized
STABILITY_CHECK_INTERVAL_MS=1000

# How many consecutive checks with unchanged size are required to mark download as complete
STABILITY_THRESHOLD_COUNT=2

# Enable desktop notifications (true/false)
ENABLE_NOTIFICATIONS=true
